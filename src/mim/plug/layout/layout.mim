/// # The layout Plugin {#layout}
///
/// @see mim::plug::layout
///
/// A CuTe-style nested `IntTuple` — shapes, strides and coordinates — plus the
/// index <-> coordinate conversions prototyped in `TypeSystem/Tuple.lean`.
///
/// This is the **dependent-typing** version: the constraints are *types*, not
/// `Bool`s.
///
/// - `Coord shape` is the type of coordinates valid for `shape`: an `Idx` at
///   every leaf, a tuple of sub-coordinates at every nest. An out-of-bounds
///   coordinate is simply not a value of `Coord shape`.
/// - a flat index into `shape` is a value of `Idx (size shape)`.
/// - `Congruent a b` is a proposition (a type): unit `[]` when `a` and `b` nest
///   identically, `⊥` when they do not; `Layout` carries such a proof, so a
///   `Layout` value is congruent by construction.
///
/// `idx_to_coord` / `coord_to_idx` are total: their signatures *are* the bounds
/// proof, so no `assert` is needed. The normalizers fold when the shape's
/// constructors are known (even if the extents are symbolic), residualizing to
/// `core.nat` arithmetic; a fully symbolic `IntTuple` stays stuck.
///
/// [TOC]
///
/// ## Dependencies
///
plugin core;
///
/// ## Types
///
/// ### IntTuple
///
/// A nested tuple of `Nat`s, mirroring Lean's mutually recursive `Tuple.bot` /
/// `Tuple.nest` and `Tuples.nil` / `Tuples.cons`.
///
pub rec IntTuple = | leaf: Nat | nest: IntTupleList
and IntTupleList = [n: Nat, «n; IntTuple»];
///
/// ### Coord
///
/// The coordinates valid for `shape`: `Coord (leaf n) = Idx n`, and
/// `Coord (nest (n, xs))` is the `n`-tuple of `Coord (xs#i)`.
///
axm Coord: IntTuple → *, normalize_coord_ty;
///
/// ### size / rank
///
/// `size` is the product of all leaves; `rank` the number of top-level children.
///
axm size: IntTuple → Nat, normalize_size;
axm rank: IntTuple → Nat, normalize_rank;
///
/// ## Index <-> Coordinate
///
/// ### idx_to_coord
///
/// Pushes a flat, in-bounds index `x: Idx (size shape)` into `Coord shape`.
///
axm idx_to_coord: [shape: IntTuple, x: Idx (size shape)] → Coord shape, normalize_idx_to_coord;
///
/// ### coord_to_idx
///
/// Pulls a bounded coordinate out to its flat index (the inverse).
///
axm coord_to_idx: [shape: IntTuple, c: Coord shape] → Idx (size shape), normalize_coord_to_idx;
///
/// ### erase
///
/// Forgets the bounds, yielding the plain `IntTuple` — interop with the
/// unrefined world.
///
axm erase: [shape: IntTuple, c: Coord shape] → IntTuple, normalize_erase;
///
/// ## Layout
///
/// ### Congruent
///
/// A proposition (type): `[]` (unit) iff `a` and `b` nest identically, `⊥`
/// (empty) otherwise.
///
axm Congruent: [IntTuple, IntTuple] → *, normalize_congruent_ty;
///
/// ### mk_congruent
///
/// The canonical inhabitant of `Congruent (a, b)`: `()` when unit, a tuple of
/// sub-proofs for a nest. Bails on `⊥`; stuck while the shapes are symbolic.
///
axm mk_congruent: [a: IntTuple, b: IntTuple] → Congruent (a, b), normalize_mk_congruent;
///
/// ### Layout
///
/// A shape, a stride, and a proof that they are congruent: every `Layout` value
/// is congruent by construction (the proof is erased at codegen).
///
pub let Layout = [shape: IntTuple, stride: IntTuple, pf: Congruent (shape, stride)];
///
/// ### make_layout
///
/// Builds a `Layout`, discharging the congruence obligation with `mk_congruent`.
///
anx lam make_layout (shape stride: IntTuple): Layout = (shape, stride, mk_congruent (shape, stride));
///
/// ### crd2idx
///
/// The layout's semantics: the memory index of coordinate `c` under `l`,
/// `Σ cᵢ · strideᵢ` (nested inner product).
///
axm crd2idx: [l: Layout, c: Coord (l#shape)] → Nat, normalize_crd2idx;
