/// # The layout Plugin {#layout}
///
/// @see mim::plug::layout
///
/// A CuTe-style nested `IntTuple` — shapes, strides and coordinates — plus the
/// index <-> coordinate conversions prototyped in `TypeSystem/Tuple.lean`.
///
/// An `IntTuple` is either a `leaf a` (a single dimension of extent `a`, Lean's
/// `Tuple.bot`) or a `nest (n, xs)` of `n` children (Lean's `Tuple.nest` /
/// `Tuples.cons`). This is a faithful port of the Lean development: the same
/// `size`, `compatible`, `contains`, `congruent`, `coord_to_idx` and
/// `idx_to_coord` — here as axioms whose normalizers *partially evaluate* them.
///
/// The normalizers fold whenever the constructors are known, even if the leaf
/// extents are still symbolic, so `coord_to_idx`, `idx_to_coord` and `size`
/// residualize to ordinary `core.nat` arithmetic (a stride/`div`/`mod` chain) —
/// no structural matching survives to runtime. A fully dynamic `IntTuple` value
/// (unknown constructors) simply stays stuck; a future `layout.lower` phase
/// would expand that case to a recursive fallback.
///
/// [TOC]
///
/// ## Dependencies
///
plugin core;
///
/// ## Types
///
/// ### IntTuple
///
/// A nested tuple of `Nat`s, mirroring Lean's mutually recursive `Tuple.bot` /
/// `Tuple.nest` and `Tuples.nil` / `Tuples.cons`:
///
/// - `leaf a`: a dimension of extent `a` (`Tuple.bot`).
/// - `nest xs`: a child list (`Tuple.nest`); `xs#0 = n` is the child count, `n = 0` and
///   `n = 1` degenerate exactly as `«n; T»` does.
///
pub rec IntTuple = | leaf: Nat | nest: IntTupleList
and IntTupleList = [n: Nat, «n; IntTuple»];
///
/// ### Layout
///
/// A shape and a stride whose nesting is congruent (Lean's `Layout.intro`).
///
pub let Layout = [shape: IntTuple, stride: IntTuple];
///
/// ## Size and Rank
///
/// ### size
///
/// The product of all leaves (Lean's `Tuple.size`).
///
axm size: IntTuple → Nat, normalize_size;
///
/// ### rank
///
/// The number of top-level children; a leaf has rank `1` (Lean's `Tuple.rank`).
///
axm rank: IntTuple → Nat, normalize_rank;
///
/// ## Constraints
///
/// All three are `Bool`-valued (mimIR has no `Prop`); wrap one in `assert`
/// (below) to turn it into a compile-time obligation — see `checked_contains`.
///
/// ### congruent
///
/// Same nesting structure, ignoring the extents (Lean's `Tuple.congruent`).
///
axm congruent: [IntTuple, IntTuple] → Bool, normalize_congruent;
///
/// ### contains
///
/// `coord` is a proper coordinate of `shape`: same nesting, every leaf strictly
/// in bounds (Lean's `Tuple.contains`). This is the bounds check.
///
axm contains: [IntTuple, IntTuple] → Bool, normalize_contains;
///
/// ### compatible
///
/// Like `contains`, but a `leaf` coordinate may also be a *flat linear index*
/// into a nested `shape` (Lean's `Tuple.compatible`).
///
axm compatible: [IntTuple, IntTuple] → Bool, normalize_compatible;
///
/// ## Index <-> Coordinate
///
/// ### coord_to_idx
///
/// Pulls a nested coordinate out to a flat index (Lean's `Tuple.coord_to_idx`).
/// The first axis is the most minor: `idx = Σₖ cₖ · ∏_{j<k} sizeⱼ`.
///
axm coord_to_idx: [shape: IntTuple, coord: IntTuple] → Nat, normalize_coord_to_idx;
///
/// ### idx_to_coord
///
/// Pushes a flat index into the nested coordinate of `shape` (Lean's
/// `Tuple.idx_to_coord`), the inverse of `coord_to_idx`.
///
axm idx_to_coord: [shape: IntTuple, idx: Nat] → IntTuple, normalize_idx_to_coord;
///
/// ### at
///
/// `idx_to_coord` with the bound carried in the type: `x: Idx (size shape)` is a
/// flat index in range *by construction*. A consumer can rely on it without an
/// `assert`, which is what makes this usable when `shape` is still symbolic — the
/// invariant travels in the signature instead of being re-checked.
///
axm at: [shape: IntTuple, x: Idx (size shape)] → IntTuple, normalize_at;
///
/// ## Checked Constructors
///
/// ### assert
///
/// `assert (cond, val, msg)` yields `val` when `cond` folds to `tt`, bails with a
/// hard compile-time error when it folds to `ff`, and stays stuck when symbolic.
/// This is `refly.check`, but fatal rather than merely logged.
///
axm assert: {T: *} → {n: Nat} → [Bool, T, «n; I8»] → T, normalize_assert;
///
/// ### bounded
///
/// Produces the singleton proof `«compatible (shape, leaf x)»`. It bails when `x`
/// is out of bounds and stays stuck while `shape` is symbolic. Thread its result
/// through your own signatures to hand the invariant to consumers — the singleton
/// is a type, so a consumer that demands `«compatible …»` can only be called with
/// a proof, not an arbitrary `‹ff›`.
///
axm bounded: [shape: IntTuple, x: Nat] → «compatible (shape, IntTuple#leaf x)», normalize_bounded;
///
/// ### at_bounded
///
/// The witness-consuming accessor: `pf` proves `x` in bounds, so no runtime check
/// is needed. Call it as `at_bounded (shape, x, bounded (shape, x))`.
///
anx lam at_bounded (shape: IntTuple, x: Nat, pf: «compatible (shape, IntTuple#leaf x)»): IntTuple =
    idx_to_coord (shape, x);
///
/// ### checked_contains
///
/// Returns `coord`, failing compilation unless `contains (shape, coord)`.
///
anx lam checked_contains (shape coord: IntTuple): IntTuple =
    assert (contains (shape, coord), coord, "coordinate out of bounds for shape");
///
/// ### checked_idx
///
/// Returns `idx`, failing compilation unless `idx` is a valid flat index of `shape`.
///
anx lam checked_idx (shape: IntTuple, idx: Nat): Nat =
    assert (compatible (shape, IntTuple#leaf idx), idx, "index out of bounds for shape");
///
/// ### make_layout
///
/// Builds a `Layout`, failing compilation unless shape and stride are congruent.
///
anx lam make_layout (shape stride: IntTuple): Layout =
    assert (congruent (shape, stride), (shape, stride), "shape and stride are not congruent");
