// RUN: %mim %s -o - | %FileCheck %s
//
// Partial evaluation: with a statically known structure but symbolic extents,
// `idx_to_coord` residualizes to `core.nat` arithmetic (no `layout.*` remains).
plugin layout;
plugin core;

lam sh (m n: Nat): layout.IntTuple =
    layout.IntTuple#nest (2, (layout.IntTuple#leaf m, layout.IntTuple#leaf n));

// Coord (sh (m, n)) = [Idx m, Idx n]; the value is (x mod m, (x / m) mod n).
extern lam crd (m n: Nat, x: Idx (layout.size (sh (m, n)))): layout.Coord (sh (m, n)) =
    layout.idx_to_coord (sh (m, n), x);

// CHECK-DAG: core.nat.mul
// CHECK-DAG: core.nat.div
// CHECK-DAG: core.nat.rem
// CHECK-NOT: layout.
