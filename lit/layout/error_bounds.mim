// RUN: (! %mim %s 2>&1) | %FileCheck %s
//
// The bound is a *type*: a plain `Nat` where `Idx (size shape)` is expected is a
// compile-time error, with no runtime check involved.
plugin layout;
plugin core;

lam it2 (a b: Nat): layout.IntTuple =
    layout.IntTuple#nest (2, (layout.IntTuple#leaf a, layout.IntTuple#leaf b));

let shape = it2 (2, 3); // size 6

extern lam bad (): layout.Coord shape = layout.idx_to_coord (shape, 5);

// CHECK: error: argument is not assignable to callee's domain
// CHECK: expected `[shape: IntTuple, x: Idx (layout.size shape)]`, got `[IntTuple, Nat]`
