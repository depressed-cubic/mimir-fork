// RUN: %mim %s
//
// The Lean `#eval` vectors of `TypeSystem/Tuple.lean`, now with the bounds and
// congruence carried as *types*:
//   #t[2, 3, #t[4, 5]]  is a size-120 shape,
//   #t[1, 2, #t[3, 4]]  is the coordinate of flat index 119,
//   coord_to_idx / idx_to_coord are inverse.

plugin layout;
plugin core;
plugin refly;

lam it2 (a b: Nat): layout.IntTuple =
    layout.IntTuple#nest (2, (layout.IntTuple#leaf a, layout.IntTuple#leaf b));
lam it3n (a b: Nat) (c: layout.IntTuple): layout.IntTuple =
    layout.IntTuple#nest (3, (layout.IntTuple#leaf a, layout.IntTuple#leaf b, c));

let shape = it3n (2, 3) (it2 (4, 5)); // #t[2, 3, #t[4, 5]]

// size / rank
let _ = refly.struc.e (layout.size shape, 120);
let _ = refly.struc.e (layout.rank shape, 3);

// idx_to_coord / coord_to_idx are inverse, and the coordinate is a nested tuple
// of *bounded* indices (`Idx`).
let c = layout.idx_to_coord (shape, 119₁₂₀);
let _ = refly.struc.e (layout.coord_to_idx (shape, c), 119₁₂₀);
let _ = refly.struc.e (c, (1₂, 2₃, (3₄, 4₅)));

// erase forgets the bounds
let _ = refly.struc.e (layout.erase (shape, c), it3n (1, 2) (it2 (3, 4)));

// a Layout carries a congruence proof; crd2idx is the nested inner product
let l = layout.make_layout (it2 (2, 3), it2 (3, 1)); // row-major (2,3): strides (3,1)
let _ = refly.struc.e (layout.crd2idx (l, (1₂, 2₃)), 5);
