// RUN: (! %mim %s 2>&1) | %FileCheck %s
//
// `bounded` bails when the index is out of bounds (shape has size 3·4 = 12).
plugin layout;

let shape = layout.IntTuple#nest (2, (layout.IntTuple#leaf 3, layout.IntTuple#leaf 4));

let _ = layout.bounded (shape, 12); // 12 is not `< 12`

// CHECK: error
// CHECK: index out of bounds for shape
